﻿@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@model PolyOmniaLayer.Models.Page.IndexViewModel
@{
    ViewData["Title"] = @SharedLocalizer["Home_Title"];
    @addTagHelper *, PolyOmniaLayer
}


<!-- HERO BANNER -->
@if (Model.home.HeroVideo != null)
{
    <div class="hero-banner p-4 p-md-5 mb-5 position-relative shadow-lg">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span class="badge mb-2 px-3 py-2 rounded-pill" style="background-color: var(--electric-indigo)">
                    @(Model.home.HeroVideo.Category ?? SharedLocalizer["Label_Default"].Value)
                </span>
                <h1 class="display-5 fw-bold text-white mb-3">@Model.home.HeroVideo.Title</h1>
                <p class="text-muted mb-2">@SharedLocalizer["Label_Author"]: <span class="text-light fw-semibold">@(Model.home.HeroVideo.User ?? SharedLocalizer["Label_User"].Value)</span></p>
                <p class="lead text-light opacity-75">@Model.home.HeroVideo.Description</p>

                <div class="d-flex gap-3 mt-4">
                    <a asp-controller="Video" asp-action="Watch" asp-route-id="@Model.home.HeroVideo.Id" class="btn btn-brand px-4 py-2 rounded-pill">
                        <i class="bi bi-play-fill fs-5 align-middle me-1"></i> @SharedLocalizer["Btn_WatchNow"]
                    </a>
                    @if (Model.home.HeroVideo.AllowDownload)
                    {
                        <a asp-controller="Video" asp-action="Download" asp-route-id="@Model.home.HeroVideo.Id" class="btn btn-outline-brand px-4 py-2 rounded-pill">
                            <i class="bi bi-download me-1"></i> @SharedLocalizer["Btn_Download"]
                        </a>
                    }
                </div>
            </div>

            <!-- Права колонка: Інтерактивне прев'ю відео -->
            <div class="col-lg-5 mt-4 mt-lg-0 text-center">
                <a asp-controller="Video" asp-action="Watch" asp-route-id="@Model.home.HeroVideo.Id" class="text-decoration-none">
                    <div class="position-relative ratio ratio-16x9 rounded-4 overflow-hidden border border-secondary shadow" style="background-color: #101014;">
                        @if (!string.IsNullOrEmpty(Model.home.HeroVideo.ThumbnailUrlOrPath))
                        {
                            <img src="@Model.home.HeroVideo.ThumbnailUrlOrPath" class="card-img-top w-100 h-100 object-fit-cover" alt="@Model.home.HeroVideo.Title" />
                        }
                        else
                        {
                            <!-- Fallback якщо немає обкладинки -->
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                <i class="bi bi-film fs-1" style="color: var(--electric-indigo)"></i>
                            </div>
                        }

                        <!-- Іконка Play при наведенні -->
                        <div class="position-absolute top-50 start-50 translate-middle text-white opacity-75">
                            <i class="bi bi-play-circle-fill display-5"></i>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
}

<!-- КАТЕГОРІЇ (Фільтр) -->
<div id="categories" class="mb-4">
    <h6 class="text-uppercase fw-bold mb-3" style="color: var(--text-muted); letter-spacing: 1px;">@SharedLocalizer["Nav_Categories"]</h6>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-sm rounded-pill px-3 @(Model.home.SelectedCategoryId == null ? "btn-brand" : "btn-outline-secondary text-light")">
            @SharedLocalizer["Category_All"]
        </a>
        @foreach (var category in Model.home.Category)
        {
            <a asp-action="Index" asp-route-categoryId="@category.Id"
               class="btn btn-sm rounded-pill px-3 @(Model.home.SelectedCategoryId == category.Id ? "btn-brand" : "btn-outline-secondary text-light")">
                @category.Name
            </a>
        }
    </div>
</div>

<!-- СІТКА ВІДЕО -->
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var video in Model.home.Videos)
    {
        <div class="col">
            <div class="card poly-card h-100">
                <!-- Preview Frame (Прев'ю з переходом на Watch) -->
                <a asp-controller="Video" asp-action="Watch" asp-route-id="@video.Id" class="text-decoration-none">
                    <div class="position-relative ratio ratio-16x9 rounded-top overflow-hidden" style="background-color: #101014;">
                        @if (!string.IsNullOrEmpty(video.ThumbnailUrlOrPath))
                        {
                            <img src="@video.ThumbnailUrlOrPath" class="card-img-top w-100 h-100 object-fit-cover" alt="@video.Title" />
                        }
                        else
                        {
                            <!-- Fallback якщо немає обкладинки -->
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                <i class="bi bi-film fs-1" style="color: var(--electric-indigo)"></i>
                            </div>
                        }

                        <!-- Іконка Play при наведенні -->
                        <div class="position-absolute top-50 start-50 translate-middle text-white opacity-75">
                            <i class="bi bi-play-circle-fill display-5"></i>
                        </div>
                    </div>
                </a>

                <div class="card-body d-flex flex-column p-3">
                    <h5 class="card-title text-white fs-6 mb-2 text-truncate" title="@video.Title">
                        <a asp-controller="Video" asp-action="Watch" asp-route-id="@video.Id" class="text-white text-decoration-none">
                            @video.Title
                        </a>
                    </h5>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge rounded-pill bg-dark border border-secondary text-light">
                            @(video.Category ?? SharedLocalizer["Label_General"].Value)
                        </span>
                        <small class="text-muted">
                            <i class="bi bi-person me-1"></i>@(video.User ?? SharedLocalizer["Label_User"].Value)
                        </small>
                    </div>

                    <div class="mt-auto pt-3 d-flex justify-content-between align-items-center border-top border-dark">
                        <div>
                            @if (video.AllowDownload)
                            {
                                <a asp-controller="Video" asp-action="Download" asp-route-id="@video.Id" class="btn btn-sm btn-outline-success me-1 rounded-pill" title="@SharedLocalizer["Btn_Download"]">
                                    <i class="bi bi-download"></i>
                                </a>
                            }
                        </div>
                        <a asp-controller="Video" asp-action="Watch" asp-route-id="@video.Id" class="btn btn-sm btn-outline-brand rounded-pill px-3">
                            @SharedLocalizer["Btn_WatchNow"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<!-- ПАГІНАЦІЯ -->
@if (Model.PageViewModel.TotalPages > 1)
{
    <page-link page-model="Model.PageViewModel"
               page-action="Index"
               page-url-searchQuery="@Model.FilterViewModel.SelectedName"
               page-url-categoryId="@Model.FilterViewModel.SelectedCategory"
               page-url-sortOrder="@Model.SortViewModel.Current">
    </page-link>
}