@using Microsoft.AspNetCore.Mvc.Localization
@model PolyOmniaLayer.Models.UserProfileViewModel
@inject IHtmlLocalizer<SharedResource> SharedLocalizer

@{
    ViewData["Title"] = SharedLocalizer["Profile_Title"];
}

@if (Model != null)
{
    <div class="container py-4">
        <!-- Шапка профілю -->
        <div class="card bg-dark text-white border-secondary p-4 rounded-3 mb-4 shadow-sm">
            <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="avatar-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold fs-3 rounded-circle shadow" style="width: 64px; height: 64px;">
                        @(string.IsNullOrEmpty(Model.Username) ? "U" : Model.Username.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <h3 class="fw-bold mb-1">@Model.Username</h3>
                        <p class="text-muted mb-0 fs-7">
                            <i class="bi bi-film me-1"></i> @Model.TotalViewsCount переглядів
                        </p>
                    </div>
                </div>

                <a asp-controller="Video" asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-4 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>@SharedLocalizer["Nav_UploadVideo"]</span>
                </a>
            </div>
        </div>

        <!-- Мої відео -->
        <h4 class="fw-bold text-white mb-3">@SharedLocalizer["Profile_MyVideos"]</h4>

        @if (Model.UserVideos == null || !Model.UserVideos.Any())
        {
            <div class="card bg-dark text-white border-secondary p-5 text-center rounded-3">
                <i class="bi bi-camera-video text-secondary display-4 mb-3"></i>
                <h5>@SharedLocalizer["Profile_NoVideosYet"]</h5>
                <p class="text-muted fs-7 mb-3">@SharedLocalizer["Profile_NoVideosDescription"]</p>
                <div>
                    <a asp-controller="Video" asp-action="Create" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="bi bi-cloud-upload me-1"></i> @SharedLocalizer["Btn_UploadNewVideo"]
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var video in Model.UserVideos)
                {
                    <div class="col">
                        <div class="card h-100 bg-dark text-white border-secondary shadow-sm rounded-3 overflow-hidden">
                            <div class="position-relative">
                                <img src="@(string.IsNullOrEmpty(video.ThumbnailUrlOrPath) ? "/images/default-thumbnail.png" : video.ThumbnailUrlOrPath)"
                                     class="card-img-top"
                                     alt="@video.Title"
                                     style="height: 180px; object-fit: cover;">
                                <span class="position-absolute bottom-0 end-0 bg-black bg-opacity-75 text-white fs-8 px-2 py-1 m-2 rounded">
                                    <i class="bi bi-eye me-1"></i>@video.ViewCount
                                </span>
                            </div>
                            <div class="card-body d-flex flex-column justify-content-between p-3">
                                <h6 class="card-title fw-bold text-truncate mb-2">@video.Title</h6>
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top border-secondary mt-2">
                                    <a asp-controller="Video" asp-action="Watch" asp-route-id="@video.Id" class="btn btn-sm btn-outline-light">
                                        <i class="bi bi-play-fill me-1"></i> Перегляд
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Moderator"))
                                    {
                                        <div class="btn-group btn-group-sm">
                                            <a asp-controller="Video" asp-action="Edit" asp-route-id="@video.Id" class="btn btn-outline-warning">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-controller="Video" asp-action="Delete" asp-route-id="@video.Id" class="btn btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}