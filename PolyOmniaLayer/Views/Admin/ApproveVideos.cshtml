@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@model IEnumerable<PolyOmniaLayer.Models.AdminVideoItemViewModel>

@{
    ViewData["Title"] = SharedLocalizer["Admin_ApproveVideos_Title"];
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white font-monospace mb-1">
                <i class="bi bi-collection-play-fill text-primary me-2"></i>@SharedLocalizer["Admin_PendingVideos_Header"]
            </h2>
            <p class="text-muted small mb-0">@SharedLocalizer["Admin_NoPendingVideosDescription"]</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-dark text-success border-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="card bg-dark text-white border-secondary p-5 text-center rounded-3 shadow-lg">
            <i class="bi bi-film text-secondary display-4 mb-3"></i>
            <h5>@SharedLocalizer["Admin_NoPendingVideos"]</h5>
            <p class="text-muted fs-7 mb-0">@SharedLocalizer["Admin_NoPendingVideosDescription"]</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var video in Model)
            {
                <div class="col">
                    <div class="card h-100 bg-dark text-white border-secondary shadow-sm rounded-3 overflow-hidden">
                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(video.ThumbnailUrlOrPath) ? "/images/default-thumbnail.png" : video.ThumbnailUrlOrPath)"
                                 class="card-img-top"
                                 alt="@video.Title"
                                 style="height: 180px; object-fit: cover;">
                            <span class="position-absolute bottom-0 end-0 bg-black bg-opacity-75 text-white fs-8 px-2 py-1 m-2 rounded">
                                <i class="bi bi-clock me-1"></i>@(string.IsNullOrEmpty(video.Duration) ? "00:00" : video.Duration)
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column justify-content-between p-3">
                            <div>
                                <h6 class="card-title fw-bold text-truncate mb-1">@video.Title</h6>
                                <p class="text-muted fs-8 mb-2">
                                    <i class="bi bi-person me-1"></i>@(video.UserName != null ? video.UserName : "User #" + video.UserId)
                                </p>
                                <p class="card-text fs-8 text-secondary text-truncate-2 mb-3">
                                    @(string.IsNullOrEmpty(video.Description) ? SharedLocalizer["No_Description"] : video.Description)
                                </p>
                            </div>

                            <div class="pt-2 border-top border-secondary">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <a asp-controller="Video" asp-action="Watch" asp-route-id="@video.Id" target="_blank" class="btn btn-sm btn-outline-light">
                                        <i class="bi bi-play-fill me-1"></i> Переглянути
                                    </a>
                                </div>
                                <div class="d-grid gap-2 d-md-flex">
                                    <form asp-action="ApproveVideo" asp-route-id="@video.Id" method="post" class="flex-fill">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success w-100 font-monospace">
                                            <i class="bi bi-check-circle me-1"></i> @SharedLocalizer["Btn_Approve"]
                                        </button>
                                    </form>
                                    <form asp-action="RejectVideo" asp-route-id="@video.Id" method="post" class="flex-fill"
                                          onsubmit="return confirm('@SharedLocalizer["Confirm_RejectVideo"]');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                            <i class="bi bi-x-circle me-1"></i> @SharedLocalizer["Btn_Reject"]
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>