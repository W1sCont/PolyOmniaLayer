@using Microsoft.AspNetCore.Mvc.Localization
@model IEnumerable<PolyOmnia.BLL.DTO.CategoryDTO>
@inject IHtmlLocalizer<SharedResource> SharedLocalizer

@{
    ViewData["Title"] = SharedLocalizer["Cat_categoryTitle"];
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white font-monospace mb-1">
                <i class="bi bi-folder-fill text-warning me-2"></i>@SharedLocalizer["Cat_category"]
            </h2>
            <p class="text-muted small mb-0">@SharedLocalizer["Cat_manage"]</p>
        </div>
        <a asp-action="CreateCategory" class="btn btn-primary font-monospace">
            <i class="bi bi-plus-lg me-1"></i> @SharedLocalizer["Cat_add"]
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-dark text-success border-success alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card bg-dark text-white border-secondary shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead class="table-borderless border-bottom border-secondary text-muted font-monospace small">
                        <tr>
                            <th scope="col" class="ps-4" style="width: 80px;">ID</th>
                            <th scope="col">@SharedLocalizer["Cat_name"]</th>
                            <th scope="col" class="text-end pe-4" style="width: 200px;">ДІЇ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">
                                    @SharedLocalizer["Cat_no_categories"]
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">#@item.Id</td>
                                    <td class="fw-semibold">@item.Name</td>
                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                                  onsubmit="return confirm(@SharedLocalizer["Cat_confirm_delete"]);">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>